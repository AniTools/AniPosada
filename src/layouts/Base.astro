---
import '../styles/global.css';
import { useT, type Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';
import { site, pick } from '../lib/content';
import { isoRange, location } from '../lib/calendar';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const enUrl = new URL('/', Astro.site);
const esUrl = new URL('/es/', Astro.site);
const canonical = lang === 'en' ? enUrl : esUrl;
const ogImage = new URL('/og-image.jpg', Astro.site);

/* Structured data: who Ani is, plus each upcoming show as an event so Google
   can list them in event search results. */
const artist = {
  '@type': 'MusicGroup',
  '@id': `${enUrl.href}#artist`,
  name: 'Aniposada',
  alternateName: 'Ana María Posada',
  url: enUrl.href,
  image: new URL(site.heroImage, Astro.site).href,
  description: t('meta.description'),
  genre: ['Latin', 'Singer-songwriter', 'Acoustic'],
  foundingLocation: 'Colombia',
  sameAs: site.socials.map((s) => s.url),
};
const today = new Date().toISOString().slice(0, 10);
const events = (await getCollection('shows'))
  .filter((s) => s.data.date >= today)
  .map((s) => {
    const { start, end } = isoRange(s);
    const note = pick(s.data.note, lang);
    return {
      '@type': 'MusicEvent',
      name: `Aniposada — ${s.data.title}`,
      startDate: start,
      ...(end ? { endDate: end } : {}),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: s.data.venue || s.data.title,
        address: { '@type': 'PostalAddress', streetAddress: s.data.venue, addressLocality: s.data.city, addressCountry: 'CA' },
      },
      image: ogImage.href,
      description: note || `${s.data.title} — ${location(s)}`,
      performer: { '@id': `${enUrl.href}#artist` },
      ...(/free|libre|gratis/i.test(s.data.note.en + s.data.note.es)
        ? { isAccessibleForFree: true, offers: { '@type': 'Offer', price: 0, priceCurrency: 'CAD', availability: 'https://schema.org/InStock', url: s.data.link || canonical.href } }
        : s.data.link ? { offers: { '@type': 'Offer', url: s.data.link, availability: 'https://schema.org/InStock' } } : {}),
    };
  });
/* Photo credit/copyright, so Google Images can show "Credit: Aniposada". */
const photoCredit = {
  creator: { '@id': `${enUrl.href}#artist` },
  creditText: 'Aniposada',
  copyrightNotice: `© ${new Date().getFullYear()} Aniposada`,
  copyrightHolder: { '@id': `${enUrl.href}#artist` },
};
const photos = (await getCollection('photos')).map((p) => ({
  '@type': 'ImageObject',
  contentUrl: new URL(p.data.image, Astro.site).href,
  caption: pick(p.data.alt, lang),
  ...photoCredit,
}));
const jsonLd = { '@context': 'https://schema.org', '@graph': [artist, ...events, ...photos] };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="theme-color" content="#110d0b" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="es" href={esUrl.href} />
    <link rel="alternate" hreflang="x-default" href={enUrl.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aniposada" />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aniposada — Singer-Songwriter & Producer" />
    <meta property="og:locale" content={lang === 'en' ? 'en_CA' : 'es_CO'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_CO' : 'en_CA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('meta.title')} />
    <meta name="twitter:description" content={t('meta.description')} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <slot />

    <script>
      // Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
