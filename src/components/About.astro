---
import { useT, type Lang } from '../i18n/ui';
import { site, pick } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="about" class="section about">
  <div class="about__grid wrap">
    <figure class="about__photo" data-reveal>
      <img src={site.aboutImage} alt={pick(site.aboutHeading, lang)} loading="lazy" width="1333" height="2000" />
      <figcaption class="about__badge" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs>
            <path id="badge-circle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" />
          </defs>
          <text>
            <textPath href="#badge-circle">
              {lang === 'en' ? 'SINGER · SONGWRITER · PRODUCER · ' : 'CANTAUTORA · PRODUCTORA · MÚSICA · '}
            </textPath>
          </text>
        </svg>
        <span>♪</span>
      </figcaption>
    </figure>

    <div class="about__copy">
      <header data-reveal>
        <p class="eyebrow">{t('about.eyebrow')}</p>
        <h2 class="title">{pick(site.aboutHeading, lang)}</h2>
      </header>

      <blockquote class="about__quote" data-reveal>
        “{pick(site.aboutQuote, lang)}”
      </blockquote>

      <div class="about__body" data-reveal>
        {site.aboutBody.map((p) => <p>{pick(p, lang)}</p>)}
      </div>

      {
        site.facts.length > 0 && (
          <dl class="about__facts" data-reveal>
            {site.facts.map((f) => (
              <div>
                <dt>{pick(f.label, lang)}</dt>
                <dd>{pick(f.value, lang)}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.7fr) 1fr;
    }
    .about__photo {
      position: sticky;
      top: 7rem;
    }
  }

  .about__photo {
    position: relative;
    isolation: isolate;
    margin: 0;
    max-width: min(400px, 80vw);
    width: 100%;
    justify-self: center;
  }
  .about__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 40% 35%;
    border-radius: var(--radius);
    box-shadow: 0 50px 90px -50px rgb(0 0 0 / 0.9);
  }
  .about__photo::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    z-index: -1;
    border: 1px solid rgb(245 162 122 / 0.45);
    border-radius: var(--radius);
  }

  .about__badge {
    position: absolute;
    left: -1.5rem;
    bottom: 2rem;
    width: 7.5rem;
    height: 7.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
  }
  .about__badge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 22s linear infinite;
  }
  .about__badge text {
    font: 600 9.4px var(--font-body);
    letter-spacing: 0.18em;
    fill: var(--ink);
  }
  .about__badge span {
    font-size: 1.75rem;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 600px) {
    .about__badge {
      left: auto;
      right: -0.25rem;
      bottom: -1.5rem;
      width: 6rem;
      height: 6rem;
    }
  }

  .about__copy {
    display: grid;
    gap: 2.25rem;
  }
  .about__quote {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--sun);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    line-height: 1.2;
    color: var(--sun-light);
  }
  .about__body {
    display: grid;
    gap: 1.15rem;
    color: rgb(243 233 220 / 0.78);
    max-width: 38rem;
  }
  .about__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 0.5rem 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .about__facts div {
    padding: 1.1rem 1.25rem;
    /* Hairline dividers that don't leave a grey hole when a row isn't full */
    box-shadow: 0 0 0 0.5px var(--line);
  }
  .about__facts dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .about__facts dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.15;
  }
</style>
