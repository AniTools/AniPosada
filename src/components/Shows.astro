---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { pick } from '../lib/content';
import { googleCalendarUrl } from '../lib/calendar';

interface Props {
  lang: Lang;
  shows: CollectionEntry<'shows'>[];
}
const { lang, shows } = Astro.props;
const t = useT(lang);
const locale = lang === 'en' ? 'en-CA' : 'es-CO';
const calendarDetails = (s: CollectionEntry<'shows'>) =>
  [s.data.time, pick(s.data.note, lang), s.data.link ?? ''].filter(Boolean).join('\n');
const part = (date: string, opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(locale, { ...opts, timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
---

{
  shows.length > 0 && (
    <section id="shows" class="section shows" data-shows>
      <div class="wrap">
        <header class="section-head" data-reveal>
          <p class="eyebrow">{t('shows.eyebrow')}</p>
          <h2 class="title">{t('shows.title')}</h2>
        </header>

        <ul class="shows__list" role="list">
          {shows.map((s) => (
            <li class="show" data-date={s.data.date} data-reveal>
              <p class="show__date">
                <span class="show__day">{part(s.data.date, { day: '2-digit' })}</span>
                <span class="show__month">{part(s.data.date, { month: 'short', year: 'numeric' })}</span>
              </p>
              <div class="show__info">
                <h3 class="show__venue">{s.data.title}</h3>
                <p class="show__place">
                  <Icon name="map-pin" size={15} />
                  <span>{[s.data.venue, s.data.city].filter(Boolean).join(', ')}</span>
                </p>
                <p class="show__details">
                  {[s.data.time, pick(s.data.note, lang)].filter(Boolean).join(' · ')}
                </p>
              </div>
              <div class="show__actions">
                <details class="cal">
                  <summary class="btn">
                    <Icon name="calendar-plus" size={17} />
                    {t('shows.calendar')}
                  </summary>
                  <div class="cal__menu">
                    <a href={googleCalendarUrl(s, calendarDetails(s))} target="_blank" rel="noopener">
                      <Icon name="arrow-up-right" size={15} />
                      {t('shows.google')}
                    </a>
                    <a href={`/shows/${s.id}.ics`} download={`aniposada-${s.id}.ics`}>
                      <Icon name="download" size={15} />
                      {t('shows.ics')}
                    </a>
                  </div>
                </details>
                {s.data.link && (
                  <a class="btn" href={s.data.link} target="_blank" rel="noopener">
                    {t('shows.tickets')}
                    <Icon name="arrow-up-right" size={16} />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .shows__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .show {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 2rem;
    align-items: center;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.4s var(--ease);
  }
  .show:hover {
    background: linear-gradient(90deg, rgb(245 162 122 / 0.06), transparent);
  }
  .show__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  @media (min-width: 720px) {
    .show {
      grid-template-columns: 9rem 1fr auto;
    }
    .show__actions {
      grid-column: auto;
      justify-content: flex-end;
    }
  }

  .cal {
    position: relative;
  }
  .cal summary {
    list-style: none;
  }
  .cal summary::-webkit-details-marker {
    display: none;
  }
  .cal[open] summary {
    border-color: var(--sun);
    color: var(--sun);
  }
  .cal__menu {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.5rem);
    left: 0;
    display: grid;
    min-width: 15rem;
    padding: 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--ink-3);
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.8);
    animation: menu-in 0.25s var(--ease);
  }
  @media (min-width: 720px) {
    .cal__menu {
      left: auto;
      right: 0;
    }
  }
  .cal__menu a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cal__menu a:hover {
    background: rgb(245 162 122 / 0.14);
  }
  .cal__menu :global(svg) {
    color: var(--sun);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .show__date {
    display: grid;
    line-height: 1;
  }
  .show__day {
    font-family: var(--font-display);
    font-size: 3.5rem;
    color: var(--sun);
  }
  .show__month {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .show__venue {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    margin-bottom: 0.4rem;
  }
  .show__place {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    color: var(--cream);
    font-size: 0.9375rem;
  }
  .show__place :global(svg) {
    flex: none;
    margin-top: 0.3em;
    color: var(--sun);
  }
  .show__details {
    margin-top: 0.2rem;
    padding-left: 1.4rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>

<script>
  // Close an open calendar menu when clicking elsewhere or pressing Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details.cal')];
  document.addEventListener('click', (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((m) => (m.open = false));
  });

  // Hide shows that have passed since the last deploy.
  const today = new Date().toISOString().slice(0, 10);
  const section = document.querySelector<HTMLElement>('[data-shows]');
  if (section) {
    section.querySelectorAll<HTMLElement>('[data-date]').forEach((li) => {
      if ((li.dataset.date ?? '') < today) li.remove();
    });
    if (!section.querySelector('[data-date]')) {
      section.remove();
      document.querySelectorAll('a[href="#shows"]').forEach((a) => a.remove());
    }
  }
</script>
