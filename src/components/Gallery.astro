---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { pick } from '../lib/content';

interface Props {
  lang: Lang;
  photos: (CollectionEntry<'photos'> & { size: { width?: number; height?: number } })[];
  albums: CollectionEntry<'albums'>[];
}
const { lang, photos, albums } = Astro.props;
const t = useT(lang);
// Tabs only make sense once there's more than one shoot to choose from.
const showTabs = albums.length > 1;
const count = (id: string) => photos.filter((p) => p.data.album === id).length;
---

{
  photos.length > 0 && (
    <section id="gallery" class="section gallery">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <p class="eyebrow">{t('gallery.eyebrow')}</p>
          <h2 class="title">{t('gallery.title')}</h2>
        </header>

        {showTabs && (
          <div class="albums" role="group" aria-label={t('gallery.albums')} data-reveal>
            <button type="button" class="album-tab" aria-pressed="true" data-album="all">
              {t('gallery.all')}
              <span>{photos.length}</span>
            </button>
            {albums.map((a) => (
              <button type="button" class="album-tab" aria-pressed="false" data-album={a.id}>
                {pick(a.data.name, lang) || a.data.title}
                <span>{count(a.id)}</span>
              </button>
            ))}
          </div>
        )}

        <ul class="masonry" role="list" data-gallery>
          {photos.map((p, i) => (
            <li data-reveal data-album={p.data.album ?? ''} style={`--delay:${(i % 3) * 0.08}s`}>
              <button type="button" aria-label={`${t('gallery.open')}: ${pick(p.data.alt, lang)}`}>
                <img
                  src={p.data.image}
                  alt={pick(p.data.alt, lang)}
                  width={p.size.width}
                  height={p.size.height}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
      </div>

      <dialog class="lightbox" data-lightbox aria-label={t('gallery.title')}>
        <img class="lightbox__img" alt="" data-lightbox-img />
        <p class="lightbox__caption" data-lightbox-caption />
        <button class="lightbox__btn lightbox__close" type="button" data-close aria-label={t('gallery.close')}>
          <Icon name="x" size={22} />
        </button>
        {photos.length > 1 && (
          <>
            <button class="lightbox__btn lightbox__prev" type="button" data-prev aria-label={t('gallery.prev')}>
              <Icon name="chevron-left" size={24} />
            </button>
            <button class="lightbox__btn lightbox__next" type="button" data-next aria-label={t('gallery.next')}>
              <Icon name="chevron-right" size={24} />
            </button>
          </>
        )}
      </dialog>
    </section>
  )
}

<style>
  .albums {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -1rem 0 2rem;
  }
  .album-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: none;
    color: var(--cream);
    font: 500 0.9375rem/1 var(--font-body);
    cursor: pointer;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .album-tab span {
    font-size: 0.75rem;
    color: var(--muted);
    transition: color 0.3s;
  }
  .album-tab:hover {
    border-color: var(--cream);
  }
  .album-tab[aria-pressed='true'] {
    background: var(--sun);
    border-color: var(--sun);
    color: var(--ink);
  }
  .album-tab[aria-pressed='true'] span {
    color: rgb(17 13 11 / 0.6);
  }

  .masonry {
    columns: 3 280px;
    column-gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .masonry li[hidden] {
    display: none;
  }
  .masonry li.is-entering {
    animation: photo-in 0.6s var(--ease) both;
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  .masonry li {
    break-inside: avoid;
    margin-bottom: clamp(0.75rem, 2vw, 1.25rem);
  }
  .masonry button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--ink-3);
    cursor: zoom-in;
  }
  .masonry img {
    width: 100%;
    height: auto;
    transition:
      transform 1s var(--ease),
      filter 0.6s;
    filter: saturate(0.92);
  }
  .masonry button:hover img {
    transform: scale(1.04);
    filter: saturate(1.05);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(0.75rem, 6vw, 6rem);
    border: 0;
    background: rgb(10 8 7 / 0.94);
    color: var(--cream);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    gap: 1rem;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .lightbox__caption {
    color: var(--muted);
    font-size: 0.9375rem;
    text-align: center;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(17 13 11 / 0.6);
    color: var(--cream);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .lightbox__btn:hover {
    background: var(--sun);
    color: var(--ink);
  }
  .lightbox__btn[hidden] {
    display: none;
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__prev {
    left: 1rem;
  }
  .lightbox__next {
    right: 1rem;
  }
  @media (max-width: 640px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-gallery]');
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (list && box) {
    const all = [...list.querySelectorAll<HTMLLIElement>('li')];
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = box.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    // The viewer only steps through the photos of the album being shown.
    let items: HTMLImageElement[] = [];
    let index = 0;
    const visible = () => all.filter((li) => !li.hidden).map((li) => li.querySelector('img')!);

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      img.src = items[index].currentSrc || items[index].src;
      img.alt = items[index].alt;
      caption.textContent = items[index].alt;
      box.querySelectorAll<HTMLElement>('[data-prev], [data-next]').forEach((b) => (b.hidden = items.length < 2));
    };

    // Album tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.album-tab')];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const album = tab.dataset.album;
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        all.forEach((li) => {
          const match = album === 'all' || li.dataset.album === album;
          li.hidden = !match;
          li.classList.remove('is-entering');
          if (match) {
            void li.offsetWidth; // restart the fade-in
            li.classList.add('is-entering', 'is-visible');
          }
        });
      })
    );

    list.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement).closest('li');
      if (!li) return;
      items = visible();
      show(items.indexOf(li.querySelector('img')!));
      box.showModal();
      document.body.style.overflow = 'hidden';
    });
    box.addEventListener('close', () => (document.body.style.overflow = ''));
    box.querySelector('[data-close]')?.addEventListener('click', () => box.close());
    box.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    box.addEventListener('click', (e) => {
      if (e.target === box) box.close();
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Swipe on phones.
    let startX = 0;
    box.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
