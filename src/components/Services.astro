---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { site, pick } from '../lib/content';

interface Props {
  lang: Lang;
  services: CollectionEntry<'services'>[];
}
const { lang, services } = Astro.props;
const t = useT(lang);
const icons: Record<string, string> = { mic: 'mic', sliders: 'sliders', pen: 'pen', guitar: 'guitar', headphones: 'headphones', heart: 'heart' };
---

<section id="services" class="section services">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t('services.eyebrow')}</p>
      <h2 class="title">{t('services.title')}</h2>
    </header>

    <ol class="services__list" role="list">
      {
        services.map((s, i) => (
          <li class="service" data-reveal style={`--delay:${i * 0.08}s`}>
            <span class="service__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="service__icon">
              <Icon name={icons[s.data.icon] ?? 'mic'} size={26} />
            </span>
            <h3 class="service__title">{pick(s.data.title, lang)}</h3>
            <p class="service__desc">{pick(s.data.description, lang)}</p>
          </li>
        ))
      }
    </ol>

    {
      site.bookingUrl && (
        <div class="services__cta" data-reveal>
          <p>{t('services.cta')}</p>
          <a class="btn btn--sun" href={site.bookingUrl} target="_blank" rel="noopener">
            <Icon name="calendar" size={18} />
            {t('services.book')}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .services__list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .service {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ink-2);
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .service::before {
    content: '';
    position: absolute;
    inset: auto -30% -60% auto;
    z-index: -1;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(245 162 122 / 0.28), transparent 65%);
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .service:hover {
    border-color: rgb(245 162 122 / 0.45);
    transform: translateY(-4px);
  }
  .service:hover::before {
    opacity: 1;
  }
  .service__num {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--muted);
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1.5rem;
    border-radius: 50%;
    background: rgb(245 162 122 / 0.12);
    color: var(--sun);
  }
  .service__title {
    font-size: clamp(1.75rem, 2.6vw, 2.15rem);
    line-height: 1.05;
  }
  .service__desc {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .services__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.5rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--radius);
    background: linear-gradient(110deg, rgb(255 210 168 / 0.14), rgb(224 120 106 / 0.1));
    border: 1px solid rgb(245 162 122 / 0.3);
  }
  .services__cta p {
    max-width: 36rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.2;
  }
</style>
