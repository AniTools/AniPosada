---
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { site, pick } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

{
  site.supportUrl && (
    <section id="support" class="support">
      <div class="wrap">
        <div class="support__card" data-reveal>
          <span class="support__cup" aria-hidden="true">
            <Icon name="coffee" size={30} />
          </span>
          <div class="support__copy">
            <p class="eyebrow">{t('support.eyebrow')}</p>
            <h2 class="support__title">{pick(site.supportHeading, lang)}</h2>
            <p class="support__body">{pick(site.supportBody, lang)}</p>
          </div>
          <a class="btn btn--sun support__btn" href={site.supportUrl} target="_blank" rel="noopener">
            <Icon name="coffee" size={18} />
            {t('support.button')}
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .support {
    padding-block: 0 clamp(4rem, 8vw, 6rem);
  }
  .support__card {
    position: relative;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid rgb(245 162 122 / 0.35);
    background:
      radial-gradient(circle at 100% 0%, rgb(255 210 168 / 0.22), transparent 55%),
      radial-gradient(circle at 0% 100%, rgb(224 120 106 / 0.16), transparent 55%),
      var(--ink-2);
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 900px) {
    .support__card {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2.5rem;
    }
  }
  .support__cup {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    box-shadow: 0 0 0 10px rgb(245 162 122 / 0.12);
    animation: steam 4s ease-in-out infinite;
  }
  @keyframes steam {
    50% {
      box-shadow: 0 0 0 16px rgb(245 162 122 / 0.06);
    }
  }
  .support__copy {
    display: grid;
    gap: 0.75rem;
  }
  .support__title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .support__body {
    max-width: 36rem;
    color: rgb(243 233 220 / 0.78);
  }
</style>
