---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n/ui';
import { site, pick } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const marquee =
  lang === 'en'
    ? ['Singer-Songwriter', 'Producer', 'Live Music', 'Colombia', 'Canada', 'Songwriting']
    : ['Cantautora', 'Productora', 'Música en vivo', 'Colombia', 'Canadá', 'Composición'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__grid wrap">
    <div class="hero__copy">
      <p class="eyebrow hero__in" style="--d:0.1s">{pick(site.tagline, lang)}</p>
      <h1 id="hero-title" class="hero__title hero__in" style="--d:0.2s">
        <span class="sr-only">Aniposada — {pick(site.tagline, lang)}</span>
        <Logo variant="wordmark" class="hero__wordmark" label="" />
      </h1>
      {
        pick(site.intro, lang) && (
          <figure class="hero__quote hero__in" style="--d:0.35s">
            <blockquote>“{pick(site.intro, lang)}”</blockquote>
            <figcaption>— Ani</figcaption>
          </figure>
        )
      }
      <div class="hero__ctas hero__in" style="--d:0.45s">
        <a class="btn btn--sun" href="#music">
          <Icon name="play" size={16} />
          {t('hero.listen')}
        </a>
        {
          site.bookingUrl && (
            <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener">
              {t('hero.book')}
              <Icon name="arrow-up-right" size={16} />
            </a>
          )
        }
      </div>
      <ul class="hero__socials hero__in" style="--d:0.55s" role="list">
        {
          site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.platform}>
                <Icon name={s.platform} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__photo">
      <img
        src={site.heroImage}
        alt=""
        width="1457"
        height="2200"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>

  <a class="hero__scroll" href="#music">
    <span>{t('hero.scroll')}</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {marquee.map((w) => (
            <span>
              {w}
              <b>✦</b>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: 7rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__glow {
    position: absolute;
    z-index: -1;
    width: min(70vw, 900px);
    aspect-ratio: 1;
    right: -12vw;
    top: -20vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 190 140 / 0.45), rgb(224 120 106 / 0.14) 45%, transparent 70%);
    filter: blur(20px);
    animation: breathe 9s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      transform: scale(1.08) translate(-2%, 3%);
      opacity: 0.8;
    }
  }

  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }
  .hero__title {
    width: 100%;
    margin: 0;
  }
  .hero__title :global(.hero__wordmark) {
    width: min(100%, 640px);
    height: auto;
    margin-left: -2%;
    color: var(--cream);
    filter: drop-shadow(0 6px 30px rgb(0 0 0 / 0.35));
  }
  .hero__quote {
    margin: 0;
    max-width: 30rem;
  }
  .hero__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.25;
    color: rgb(243 233 220 / 0.92);
    text-wrap: balance;
  }
  .hero__quote figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--sun);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__socials {
    display: flex;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__socials a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--muted);
    transition:
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .hero__socials a:hover {
    color: var(--sun);
    border-color: var(--sun);
    transform: translateY(-2px);
  }

  /* Phones: the photo becomes a soft full-bleed backdrop behind the copy. */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
  }
  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(17 13 11 / 0.35) 0%, rgb(17 13 11 / 0.55) 40%, var(--ink) 92%),
      linear-gradient(90deg, rgb(17 13 11 / 0.5), transparent);
  }
  @media (min-width: 900px) {
    .hero {
      align-items: center;
    }
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 6vw, 6rem);
    }
    .hero__photo {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 4 / 5.2;
      max-height: 78svh;
      justify-self: end;
      width: 100%;
      border-radius: 999px 999px var(--radius) var(--radius);
      overflow: hidden;
      box-shadow:
        0 40px 80px -30px rgb(0 0 0 / 0.7),
        0 0 0 1px var(--line);
      animation: rise 1.4s var(--ease) both 0.15s;
    }
    .hero__photo img {
      object-position: 50% 30%;
    }
    .hero__photo::after {
      background: linear-gradient(180deg, transparent 60%, rgb(17 13 11 / 0.4));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: rise 1.1s var(--ease) both;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .hero__scroll i {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--sun), transparent);
    animation: drip 2.2s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
  @media (min-width: 900px) and (min-height: 760px) {
    .hero__scroll {
      display: flex;
    }
  }

  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1.1rem;
    background: var(--ink-2);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: scroll-x 38s linear infinite;
  }
  .marquee__group {
    display: flex;
  }
  .marquee span {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    white-space: nowrap;
    color: rgb(243 233 220 / 0.85);
  }
  .marquee b {
    font-style: normal;
    font-size: 0.6em;
    color: var(--sun);
  }
  @keyframes scroll-x {
    to {
      transform: translateX(-50%);
    }
  }
</style>
